# Public BODS host domain. This derives www, data, publish, and admin origins.
NEXT_PUBLIC_BODS_BASE_DOMAIN=localhost
# Public port for the Next.js service. Omit in deployed environments using standard HTTPS.
NEXT_PUBLIC_BODS_PORT=3000
# Internal Django service origin used by Next server code.
DJANGO_INTERNAL_ORIGIN=http://localhost:8000
# Domain Django uses to select its host-specific URLconf. Defaults to bods.local locally.
DJANGO_HOST_DOMAIN=localhost
# local developmen - leave empty or use localhost
NEXT_PUBLIC_COOKIE_DOMAIN=.bus-data.dft.gov.uk
NODE_ENV=development

SUPPORT_PHONE=
SUPPORT_EMAIL=
AVL_IP_ADDRESS_LIST=__change_me__

# Feature flags mirrors the django-waffle flag of the same name.
FEATURE_FLAG_DQS_REQUIRE_ATTENTION=false
FEATURE_FLAG_DQS_REQUIRE_ATTENTION_COMPLIANCE_REPORT_ACTIVE=true
FEATURE_FLAG_EXTRACT_TRACKS_DATA=true
FEATURE_FLAG_IS_AVL_CONSUMER_SUBS_ACTIVE=true
FEATURE_FLAG_IS_AVL_REQUIRE_ATTENTION_ACTIVE=true
FEATURE_FLAG_IS_CANCELLATION_LOGIC_ACTIVE=true
FEATURE_FLAG_IS_CANCELLATIONS_LIVE=true
FEATURE_FLAG_IS_COMPLETE_SERVICE_PAGES_ACTIVE=true
FEATURE_FLAG_IS_COMPLETE_SERVICE_PAGES_REAL_TIME_DATA_ACTIVE=true
FEATURE_FLAG_IS_CREATE_SEVEN_DAY_PPC_REPORT_DAILY=true
FEATURE_FLAG_IS_FARES_CAPPING_RULE_VALIDATION_ENABLED=false
FEATURE_FLAG_IS_FARES_REQUIRE_ATTENTION_ACTIVE=true
FEATURE_FLAG_IS_FARES_REQUIRE_ATTENTION_COMPLIANCE_REPORT_ACTIVE=true
FEATURE_FLAG_IS_FARES_SERVERLESS_PUBLISHING_ACTIVE=true
FEATURE_FLAG_IS_FARES_VALIDATOR_ACTIVE=true
FEATURE_FLAG_IS_FRANCHISE_ORGANISATION_ACTIVE=true
FEATURE_FLAG_IS_GTFS_SERVICE_ALERTS_LIVE=false
FEATURE_FLAG_IS_NEW_DATA_QUALITY_SERVICE_ACTIVE=true
FEATURE_FLAG_IS_NEW_GTFS_API_ACTIVE=true
FEATURE_FLAG_IS_OPERATOR_PREFETCH_SRA_ACTIVE=true
FEATURE_FLAG_IS_PREFETCH_DB_COMPLIANCE_REPORT_ACTIVE=true
FEATURE_FLAG_IS_SERVERLESS_PUBLISHING_ACTIVE=true
FEATURE_FLAG_IS_SPECIAL_DAYS_PPC_LOGIC_ACTIVE=true
FEATURE_FLAG_IS_SPECIFIC_FEEDBACK=true
FEATURE_FLAG_IS_SPLIT_REGISTRATION_LOGIC_ACTIVE=true
FEATURE_FLAG_IS_TIMETABLE_VISUALISER_ACTIVE=true
FEATURE_FLAG_IS_UILTA_PREFETCH_SRA_ACTIVE=true
FEATURE_FLAG_IS_USING_STEP_FUNCTION_FOR_DQS=true
